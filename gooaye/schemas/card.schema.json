{
  "type": "object",
  "properties": {
    "ep": {"type": "integer"},
    "prompt_version": {"type": "string"},
    "model": {"type": "string"},
    "segments": {
      "description": "只有輸入標記為『未分段』時才填；已分段則輸出空陣列",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seg_id": {"type": "string"},
          "type": {"type": "string", "enum": ["opening", "sponsor", "life_chat", "market", "industry", "pep_talk", "qa_item", "other"]},
          "title": {"type": "string"},
          "start_p": {"type": "integer"},
          "end_p": {"type": "integer"}
        },
        "required": ["seg_id", "type", "title", "start_p", "end_p"],
        "additionalProperties": false
      }
    },
    "cards": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "kind": {"type": "string", "enum": ["belief", "heuristic", "market_view", "self_correction", "qa", "story", "expression", "uncertainty"]},
          "lens": {"type": "string", "enum": ["invest", "life", "both"]},
          "seg_id": {"type": "string"},
          "paragraph": {"type": "integer"},
          "claim": {"type": "string"},
          "quote": {"type": "string", "maxLength": 60},
          "tone": {"type": "string", "enum": ["serious", "joking", "sarcastic", "hedged"]},
          "speaker": {"type": "string", "enum": ["self", "listener_question", "quoting_other"]},
          "condition": {"type": ["string", "null"]},
          "mv": {
            "description": "只有 kind=market_view 時填，其餘為 null",
            "type": ["object", "null"],
            "properties": {
              "subject": {"type": "string"},
              "direction": {"type": "string", "enum": ["bullish", "bearish", "neutral", "holding", "exited"]},
              "rationale": {"type": "string"},
              "invalidation": {"type": ["string", "null"]}
            },
            "required": ["subject", "direction", "rationale", "invalidation"],
            "additionalProperties": false
          },
          "qa_question": {"type": ["string", "null"]},
          "tags": {"type": "array", "items": {"type": "string"}, "maxItems": 3}
        },
        "required": ["kind", "lens", "seg_id", "paragraph", "claim", "quote", "tone", "speaker", "condition", "mv", "qa_question", "tags"],
        "additionalProperties": false
      }
    }
  },
  "required": ["segments", "cards"],
  "additionalProperties": true
}
